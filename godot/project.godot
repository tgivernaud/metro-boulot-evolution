; Engine configuration file.
; Metro Boulot Evolution — Godot 4 starter
config_version=5

[application]
config/name="Métro, Boulot, Évolution"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Simulation de vie 3D mobile"

[display]
window/size/viewport_width=1170
window/size/viewport_height=2532
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.65, 0.8, 0.91, 1)
